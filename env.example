# ============================================================
# VANESSA TOURISME - variables d'environnement
# Copie ce fichier en `.env` puis remplis les valeurs.
# ============================================================

# ------------------------------------------------------------
# 1) Variables du site (exposees au navigateur - prefixe VITE_)
#    Ne JAMAIS mettre de cle secrete ici.
# ------------------------------------------------------------

# Meme projet Appwrite que Vanessa : comptes et collection `users` partages
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_DATABASE_ID=
# Collection `users` partagée avec Vanessa : MÊME valeur que VITE_APPWRITE_COLLECTION_USERS de Vanessa
VITE_APPWRITE_COLLECTION_USERS=

# URL publique de ce site (sert aux redirections OAuth Google)
VITE_APP_URL=http://localhost:5173

# URL du site Vanessa (lien "Ouvrir dans Vanessa")
VITE_VANESSA_APP_URL=

# IDs des Appwrite Functions (voir dossier /functions)
VITE_FN_TOUR_CHAT=tour-chat
VITE_FN_CREATE_BOOKING=tour-create-booking
VITE_FN_BOOKING_STATUS=tour-booking-status
VITE_FN_REVIEW=tour-review

# Style de carte MapLibre (URL d'un style JSON)
VITE_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json

# ------------------------------------------------------------
# 2) Scripts locaux uniquement (scripts/setup-appwrite.mjs, seed-demo.mjs)
#    Cle API avec les droits databases/collections/buckets.
#    NE PAS ajouter dans Netlify. NE PAS commiter le .env.
# ------------------------------------------------------------
APPWRITE_API_KEY=

# ------------------------------------------------------------
# 3) Variables des Appwrite Functions
#    A definir dans la console Appwrite (Function > Settings > Variables),
#    pas dans ce fichier. Listees ici pour memoire :
#
#    APPWRITE_API_KEY        cle serveur de la function
#    VANESSA_API_URL         endpoint de vanessa-api
#    VANESSA_API_KEY         cle d'acces a vanessa-api
#    CHAT_DAILY_LIMIT        messages/jour/utilisateur (ex: 50)
#    RESEND_API_KEY          emails de confirmation
#    MAIL_FROM               ex: Vanessa Tourisme <no-reply@votre-domaine.com>
#    (phase 2) cles du fournisseur de paiement mobile money
# ------------------------------------------------------------
